# ── Database ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quantsignal?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<your-strong-random-secret>
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Pinecone (Architecture §9.0) ──────────────────────────────────────────────
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=quantsignal

# ── OpenAI (text-embedding-ada-002, 1536 dims) ────────────────────────────────
OPENAI_API_KEY=<your-openai-api-key>

# ── Google Gemini (LangChain agents) ──────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>

# ── Nvidia (text-embedding) ───────────────────────────────────────────────────
NVIDIA_API_KEY=<your-nvidia-api-key>

# ── CORS (production only — set on Render) ────────────────────────────────────
# CORS_ORIGIN=https://your-frontend.vercel.app
